/* 应用图标与版本信息，编译时用 windres 打成 .o 链进 exe。 */

#include <windows.h>

/* IDI_APPICON = 1，供 LoadIcon 使用；Windres 会把 icon.ico 里的全部尺寸
   （16/24/32/48/64/128/256）都收进去，资源管理器会按需挑选。 */
1 ICON "icon.ico"

/* 下面两个版本号和 StringFileInfo 里的字符串版本，由 build-exe.ps1 在编译前
   按仓库根目录的 VERSION 文件替换，这里的值只是占位（也是拿不到 VERSION 时
   的兜底）。改版本号请改 VERSION，不要只改这里。 */
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0409 = 英语(美国)，04b0 = Unicode；版本信息本身用英文，
           免得在非中文系统上显示成乱码 */
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "onenote-export-tool"
            VALUE "FileDescription",  "OneNote Export Tool - GUI launcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "OneNote导出工具"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "OneNote导出工具.exe"
            VALUE "ProductName",      "OneNote Export Tool"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
